import { Store, TaskData } from "globals.slint";

component TaskRow inherits Rectangle {
    in property <TaskData> data;
    property <float> entrance: 0;
    property <float> collapse: data.dying ? 1 : 0;
    property <length> row-height: Store.motion-enabled ? 34px * (1 - collapse) : 34px;

    animate entrance { duration: 220ms; easing: ease_out; }
    animate collapse { duration: 220ms; delay: 140ms; easing: ease_in; }
    init => { self.entrance = 1; }

    preferred-height: row-height;
    min-height: row-height;
    max-height: row-height;
    opacity: Store.motion-enabled ? (data.dying ? 1 - collapse : (data.is-new ? entrance : 1)) : 1;
    border-radius: 8px;
    clip: true;
    background: row-hover.has-hover || complete.has-hover ? #364357 : #ffffff0b;
    border-width: 1px;
    border-color: row-hover.has-hover || complete.has-hover ? #54637c : #ffffff0c;

    row-hover := TouchArea {}

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 7px;
        spacing: 4px;

        Rectangle {
            width: 24px;
            accessible-role: checkbox;
            accessible-label: "完成任务：\{root.data.title}";
            accessible-checked: root.data.dying;
            accessible-enabled: complete.enabled;
            accessible-action-default => {
                if (complete.enabled) {
                    Store.done(root.data.id);
                }
            }
            Rectangle {
                width: 15px;
                height: 15px;
                border-radius: 5px;
                border-width: 1px;
                border-color: root.data.dying || complete.has-hover ? #9de8cc : #75839a;
                background: root.data.dying ? #9de8cc : transparent;
                if root.data.dying : Path {
                    commands: "M 3.5 7.8 L 6.1 10.4 L 11.6 4.8";
                    stroke: #143027;
                    stroke-width: 1.7px;
                }
            }
            complete := TouchArea {
                enabled: !root.data.dying;
                mouse-cursor: pointer;
                clicked => { Store.done(root.data.id); }
            }
        }

        Text {
            text: root.data.title;
            color: #eef2fa;
            font-size: 13px;
            min-width: 0px;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.data.high : Rectangle {
            width: 19px;
            Rectangle {
                height: 17px;
                border-radius: 5px;
                background: #f6c67423;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "高";
                    color: #f8cf86;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if root.data.time != "" : Text {
            text: root.data.time;
            color: root.data.overdue ? #ffa5a5 : #aebbd2;
            font-size: 11px;
            min-width: 0px;
            max-width: 100px;
            horizontal-stretch: 0;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component Column inherits Rectangle {
    in property <[TaskData]> rows;
    in property <string> label;
    in property <string> empty-text: "暂无任务";
    in property <int> count;
    in property <color> accent;
    in property <color> card-fill: #1a2233;
    in property <color> card-border: #333f55;

    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    border-radius: 15px;
    border-width: 1px;
    border-color: card-border;
    background: card-fill;

    HorizontalLayout {
        x: 13px;
        y: 10px;
        width: parent.width - 26px;
        height: 28px;
        spacing: 8px;

        Rectangle {
            width: 7px;
            Rectangle {
                height: 7px;
                border-radius: 3.5px;
                background: root.accent;
            }
        }
        Text {
            text: root.label;
            color: #eef2fa;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: count-label.preferred-width + 14px;
            Rectangle {
                height: 22px;
                border-radius: 7px;
                background: #ffffff0b;
                count-label := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.count;
                    color: root.accent;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    Rectangle {
        x: 12px;
        y: 46px;
        width: parent.width - 24px;
        height: 1px;
        background: root.card-border;
    }

    if root.rows.length == 0 : Rectangle {
        x: 11px;
        y: 56px;
        width: parent.width - 22px;
        height: parent.height - 67px;
        border-radius: 9px;
        border-width: 1px;
        border-color: #ffffff0c;
        background: #0d12232e;

        VerticalLayout {
            alignment: center;
            spacing: 9px;
            Rectangle {
                height: 32px;
                Rectangle {
                    width: 32px;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: root.card-border;
                    background: #ffffff07;
                    Path {
                        width: 14px;
                        height: 14px;
                        commands: "M 2 7.5 L 5.5 11 L 12 4";
                        stroke: root.accent;
                        stroke-width: 1.5px;
                    }
                }
            }
            Text {
                text: root.empty-text;
                color: #a9b6cc;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }

    tasks := Flickable {
        x: 11px;
        y: 56px;
        width: parent.width - 17px;
        height: parent.height - 67px;
        content-width: self.width;
        content-height: max(self.height, task-list.min-height);
        interactive: self.content-height > self.height;
        visible: root.rows.length > 0;

        task-list := VerticalLayout {
            y: 0px;
            x: 0px;
            width: tasks.width;
            height: self.min-height;
            spacing: 5px;
            padding-right: 5px;
            for task in root.rows : TaskRow {
                data: task;
            }
        }
    }

    if tasks.content-height > tasks.height : Rectangle {
        x: tasks.x + tasks.width - 2px;
        y: tasks.y + (-tasks.content-y / (tasks.content-height - tasks.height)) * (tasks.height - self.height);
        width: 2px;
        height: max(12px, tasks.height * (tasks.height / tasks.content-height));
        border-radius: 1px;
        background: #62748c;
    }
}
