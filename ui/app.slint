import { Column } from "widgets.slint";
import { Store } from "globals.slint";
export { Store }

component QuickAdd inherits Rectangle {
    callback submitted(string);
    height: 42px;
    border-radius: 12px;
    background: #0d121dfa;
    border-width: 1px;
    border-color: entry.has-focus ? #76bfa9 : #2c3547;

    function submit() {
        if (entry.text != "") {
            root.submitted(entry.text);
            entry.text = "";
        }
    }

    entry := TextInput {
        x: 13px;
        width: parent.width - 95px;
        height: parent.height - 2px;
        color: #eef2fa;
        font-size: 13px;
        vertical-alignment: center;
        accessible-label: "一句话添加任务";
        accepted => { root.submit(); }
    }
    if entry.text == "" : Text {
        x: entry.x;
        width: entry.width;
        height: entry.height;
        text: "例如：明天 9点 交作业 !高";
        color: #8995ad;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: parent.width - self.width - 5px;
        width: 70px;
        height: 32px;
        border-radius: 8px;
        background: entry.text == "" ? #253a3d : (add.has-hover ? #a6f2d7 : #89dfc0);
        accessible-role: button;
        accessible-label: "添加任务";
        accessible-enabled: add.enabled;
        accessible-action-default => { root.submit(); }

        Text {
            width: parent.width;
            height: parent.height;
            text: "+ 添加";
            color: entry.text == "" ? #a1c6be : #092820;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        add := TouchArea {
            enabled: entry.text != "";
            mouse-cursor: pointer;
            clicked => { root.submit(); }
        }
    }
}

export component AppWindow inherits Window {
    width: 856px;
    height: 424px;
    no-frame: true;
    title: "TaskBoardWidget";
    background: transparent;
    in-out property <bool> force-on-top: false;
    always-on-top: root.force-on-top;
    default-font-family: "Noto Sans CJK SC";

    Rectangle {
        x: 16px;
        y: 20px;
        width: parent.width - 32px;
        height: parent.height - 32px;
        border-radius: 23px;
        background: #03070c68;
        drop-shadow-blur: 24px;
        drop-shadow-color: #03070c9e;
    }

    Rectangle {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: parent.height - 28px;
        border-radius: 23px;
        clip: true;
        border-width: 1px;
        border-color: #455269;
        background: @linear-gradient(145deg, #243845fd 0%, #1a2434fd 45%, #121825fd 100%);

        TouchArea {
            property <length> last-x;
            property <length> last-y;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                }
                if (ev.kind == PointerEventKind.up) {
                    Store.save-pos();
                }
            }
            moved => {
                if (self.pressed) {
                    Store.drag-by(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                }
            }
        }

        VerticalLayout {
            padding-top: 19px;
            padding-bottom: 11px;
            padding-left: 20px;
            padding-right: 20px;
            spacing: 12px;

            HorizontalLayout {
                height: 54px;
                spacing: 12px;

                Rectangle {
                    width: 44px;

                    Rectangle {
                        height: 44px;
                        border-radius: 13px;
                        border-width: 1px;
                        border-color: #588477;
                        background: @linear-gradient(140deg, #355e58 0%, #263d42 100%);

                        Path {
                            width: 22px;
                            height: 22px;
                            commands: "M 2 6 L 4.5 8.5 L 8 4.5 M 11.5 7 L 20 7 M 2 14 L 4.5 16.5 L 8 12.5 M 11.5 15 L 17 15";
                            stroke: #adf1d9;
                            stroke-width: 1.6px;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "我的一天";
                        color: #f4f7fd;
                        font-size: 23px;
                        font-weight: 650;
                    }
                    Text {
                        text: "\{Store.n-total} 项待办";
                        color: #afbbce;
                        font-size: 12px;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 322px;
                    QuickAdd {
                        submitted(raw) => { Store.add-task(raw); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                Column {
                    rows: Store.today;
                    label: "今天";
                    empty-text: "今天没有待办";
                    count: Store.n-today;
                    accent: #9de8cc;
                    card-fill: #1b2a33;
                    card-border: #405b60;
                }
                Column {
                    rows: Store.soon;
                    label: "未来 7 天";
                    count: Store.n-soon;
                    accent: #c2bbfb;
                }
                Column {
                    rows: Store.later;
                    label: "以后";
                    count: Store.n-later;
                    accent: #a7b8d6;
                }
            }

            Rectangle {
                height: 27px;
                Rectangle {
                    width: parent.width;
                    y: 0px;
                    height: 1px;
                    background: #30394c;
                }
                HorizontalLayout {
                    y: 5px;
                    height: parent.height - 5px;
                    spacing: 8px;
                    Rectangle {
                        width: 6px;
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Store.status-color;
                        }
                    }
                    Text {
                        text: Store.status-text;
                        color: #adbacf;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        overflow: elide;
                    }
                    Text {
                        text: "拖动空白处移动 · 托盘菜单";
                        color: #8f9bb2;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
            }
        }
    }
}
