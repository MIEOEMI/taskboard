// 桌面任务挂件 · Slint 版
// 深色玻璃渐变面板 + 三团漂移彩色光斑 + 顶部高光带 + 1px 内描边
import { Column } from "widgets.slint";
import { Store, TaskData } from "globals.slint";
export { Store }
import { Pill } from "widgets.slint";

export component AppWindow inherits Window {
    width: 760px;
    height: 452px;
    no-frame: true;
    title: "TaskBoardWidget";
    background: transparent;
    in-out property <bool> force-on-top: false;
    always-on-top: root.force-on-top;
    default-font-family: "Noto Sans CJK SC";

    // ---- 影子层：让挂件从壁纸上浮起来（模仿 QGraphicsDropShadowEffect blur46/offset12） ----
    Rectangle {
        x: 20px;
        y: 34px;
        width: parent.width - 40px;
        height: parent.height - 40px;
        border-radius: 18px;
        background: rgba(0, 0, 0, 0.55);
        drop-shadow-blur: 42px;
        drop-shadow-color: rgba(0, 0, 0, 0.85);
    }

    panel := Rectangle {
        x: 18px;
        y: 18px;
        width: parent.width - 36px;
        height: parent.height - 36px;
        border-radius: 18px;
        clip: true;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.157);   // 1px 内描边
        background: @linear-gradient(135deg,
            #202735f7 0%,   // 左上偏亮
            #151922f5 55%,
            #0c0f16f9 100%  // 右下近黑
        );

        // ---- 拖动（背景层，不挡输入框/按钮） ----
        drag := TouchArea {
            property <length> lx: 0;
            property <length> ly: 0;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    lx = self.mouse-x;
                    ly = self.mouse-y;
                }
                if (ev.kind == PointerEventKind.up) {
                    Store.save-pos();
                }
            }
            moved => {
                Store.drag-by(self.mouse-x - lx, self.mouse-y - ly);
                lx = self.mouse-x;
                ly = self.mouse-y;
            }
        }

        // ---- 三团缓慢漂移的彩色光斑（青绿/蓝/紫，18 秒一轮） ----
        property <float> k: Store.phase * 360;   // 角度
        Rectangle {
            x: parent.width * (0.16 + 0.08 * Math.sin(k * 1deg)) - self.width / 2;
            y: parent.height * (0.06 + 0.07 * Math.cos(k * 0.8 * 1deg)) - self.height / 2;
            width: 640px;
            height: 640px;
            background: @radial-gradient(circle,
                #40dc9684 0%, #40dc966b 50%, #40dc9600 100%);   // 青绿
        }
        Rectangle {
            x: parent.width * (0.88 + 0.07 * Math.cos(k * 0.9 * 1deg)) - self.width / 2;
            y: parent.height * (0.02 + 0.08 * Math.sin(k * 1.1 * 1deg)) - self.height / 2;
            width: 588px;
            height: 588px;
            background: @radial-gradient(circle,
                #4696ff78 0%, #4696ff50 50%, #4696ff00 100%);   // 蓝
        }
        Rectangle {
            x: parent.width * (0.50 + 0.14 * Math.sin(k * 0.7 * 1deg + 68.8deg)) - self.width / 2;
            y: parent.height * (1.06 + 0.07 * Math.cos(k * 0.8 * 1deg)) - self.height / 2;
            width: 742px;
            height: 742px;
            background: @radial-gradient(circle,
                #a569ff70 0%, #a569ff48 50%, #a569ff00 100%);   // 紫
        }

        // ---- 顶部高光带：玻璃被光打到的感觉 ----
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height * 0.42;
            background: @linear-gradient(180deg,
                rgba(255, 255, 255, 0.102) 0%,
                rgba(255, 255, 255, 0.035) 45%,
                rgba(255, 255, 255, 0) 100%);
        }

        // ---- 顶边一道更亮的细线，强化「浮起」的厚度感 ----
        Rectangle {
            x: 18px;
            y: 0.8px;
            width: parent.width - 36px;
            height: 1px;
            background: rgba(255, 255, 255, 0.243);
        }

        // ---- 内容 ----
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 13px;
            padding-bottom: 11px;
            spacing: 9px;

            // 顶栏
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "我的一天";
                    color: #eef2f8;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Pill {
                    text: "\{Store.n-total} 项";
                    y: 2px;
                }
                Rectangle {}   // stretch
                input := Rectangle {
                    width: 272px;
                    height: 30px;
                    border-radius: 9px;
                    background: rgba(255, 255, 255, 0.055);
                    border-width: 1px;
                    border-color: ti.has-focus ? rgba(76, 159, 112, 0.75) : rgba(255, 255, 255, 0.086);
                    ti := TextInput {
                        x: 10px;
                        y: 6px;
                        width: parent.width - 20px;
                        font-size: 12px;
                        color: #eef2f8;
                        single-line: true;
                        accepted => {
                            Store.add-task(self.text);
                            self.text = "";
                        }
                    }
                    if ti.text == "" : Text {
                        x: 10px;
                        y: 7px;
                        text: "一句话添加：明天 9点 交作业 !高";
                        color: #6b7484;
                        font-size: 12px;
                    }
                }
            }

            // 顶部高光分隔线
            Rectangle {
                height: 1px;
                background: @linear-gradient(90deg,
                    rgba(255, 255, 255, 0) 0%,
                    rgba(255, 255, 255, 0.118) 50%,
                    rgba(255, 255, 255, 0) 100%);
            }

            // 三列
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 16px;
                Column {
                    rows: Store.today;
                    label: "今天";
                    dot-color: #4c9f70;
                    pill-text: Store.n-today;
                }
                Column {
                    rows: Store.soon;
                    label: "未来 7 天";
                    dot-color: rgba(255, 255, 255, 0.235);
                    pill-text: Store.n-soon;
                }
                Column {
                    rows: Store.later;
                    label: "以后";
                    dot-color: rgba(255, 255, 255, 0.235);
                    pill-text: Store.n-later;
                }
            }

            // 状态栏
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    y: 4px;
                    border-radius: 3px;
                    background: Store.status-color;
                    opacity: Store.busy ? 0.25 + 0.75 * (0.5 + 0.5 * Math.sin(Store.clock * 276.6deg)) : 0.75;
                }
                Text {
                    text: Store.status-text;
                    color: #8b93a3;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle {}   // stretch
                Text {
                    text: "拖动移动 · 托盘菜单";
                    color: #6b7484;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
